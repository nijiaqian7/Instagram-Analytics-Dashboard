{
  "appId": "com.sns.monitor",
  "productName": "SNS-Monitor",
  "directories": {
    "output": "dist"
  },
  "files": [
    "electron/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": ".next/standalone",
      "to": "standalone"
    },
    {
      "from": ".next/standalone/node_modules",
      "to": "standalone/node_modules"
    }
  ],
  "win": {
    "target": "portable",
    "requestedExecutionLevel": "asInvoker"
  },
  "portable": {
    "artifactName": "SNS-Monitor-Portable.exe"
  },
  "asar": true,
  "asarUnpack": [
    "**/*.node"
  ]
}
